_kernel_oserror* driver (_kernel_swi_regs* r, void* pw)
{
    switch (r->r[0])
    {
    case DeviceFSCallDevice_Terminate:
        irq_buf = 0;
        break;
    case DeviceFSCallDevice_StreamCreated:
        irq_buf = r->r[3];
        break;
    }

    return NULL;
