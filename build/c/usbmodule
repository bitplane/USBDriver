struct device* get_softc (int unit)
{
    struct device* dev;
    TAILQ_FOREACH(dev, &allbuses, dv_list)
    {
        if (dev->dv_unit == ((unit >> 16) & 0xff))
            return dev;
    }

    dprintf (("", "couldn't find unit %x\n", unit));
    return NULL;
}

/*---------------------------------------------------------------------------*/

struct device* get_usbdev (int unit)
{
    struct device* dev;
    TAILQ_FOREACH(dev, &allusbdevs, dv_list)
    {
        if (dev->dv_unit == unit)
        {
            return dev;
        }
    }
    dprintf (("", "couldn't find unit %x\n", unit));

    return NULL;
}

